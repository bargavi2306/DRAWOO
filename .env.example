# DRAWO Environment Variables Template

# ==========================================
# 1. Backend Configuration (Node.js Server)
# Host on a persistent environment (Render, Railway, Fly.io, VPS)
# ==========================================
PORT=4000
NODE_ENV=production

# CLIENT_ORIGIN: Allowed frontend origin(s), comma-separated.
# Example: https://drawoo.vercel.app or http://localhost:3000 for local dev.
CLIENT_ORIGIN=https://drawoo.vercel.app

# ==========================================
# 2. Frontend Configuration (Vite on Vercel)
# ==========================================
# VITE_SOCKET_URL: Publicly accessible URL of the deployed Socket.IO backend.
# MUST use https:// in production to prevent mixed-content blocking.
# Example: https://drawoo.onrender.com (or http://localhost:4000 for dev)
VITE_SOCKET_URL=https://drawoo.onrender.com
